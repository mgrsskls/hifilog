<% parent = resource.product %>

<div>
  <div class="mb-4">
    <p>
      <strong><%= resource.display_name %></strong> will become a standalone product. Its owners,
      notes, options, bookmarks and edit history move with it. The variant is deleted afterwards,
      so its current URL stops working.
    </p>
    <p>
      It stays with <strong><%= parent.brand.name %></strong> — a conversion never changes brand.
      Categories and specs are inherited from <strong><%= parent.display_name %></strong> and can
      be adjusted here.
    </p>
  </div>

  <%= form_for resource, url: convert_to_product_admin_product_variant_path(resource), method: :post, html: { class: "formtastic" } do |f| %>
    <div class="input">
      <label class="label" for="product_name">Product name</label>
      <input type="text" name="product_name" id="product_name" value="<%= resource.name %>" required>
    </div>

    <fieldset class="input mb-4">
      <legend class="font-bold text-xl">Categories</legend>
      <% Category.includes(:sub_categories).order(:name).each do |category| %>
        <fieldset class="choices">
          <legend class="label"><b><%= category.name %></b></legend>
          <ol class="choices-group">
            <% category.sub_categories.order(:name).each do |sub_category| %>
              <li class="choice">
                <label>
                  <input type="checkbox"
                        name="sub_category_ids[]"
                        value="<%= sub_category.id %>"
                        <%= "checked" if parent.sub_category_ids.include?(sub_category.id) %>>
                  <%= sub_category.name %>
                </label>
              </li>
            <% end %>
          </ol>
        </fieldset>
      <% end %>
    </fieldset>

    <% if parent.custom_attributes.present? %>
      <div class="input">
        <label class="label">Specs inherited from <%= parent.display_name %></label>
        <p class="inline-hints"><%= parent.custom_attributes.map { |k, v| "#{k}: #{v}" }.join(", ") %></p>
        <label>
          <input type="checkbox" name="inherit_custom_attributes" value="1" checked>
          Copy these specs to the new product
        </label>
      </div>
    <% end %>

    <div class="actions">
      <button type="submit">Convert to Product</button>
    </div>
  <% end %>
</div>
