<% content_for :css do %>
  <%= stylesheet_link_tag "entity" %>
  <%= stylesheet_link_tag "product" %>
<% end %>
<% content_for :js do %>
  <%= javascript_include_tag "gallery", type: "module" %>
<% end %>
<div class="Entity">
  <div class="Entity-main">
    <div class="Heading">
      <h1>
        <% if @product.brand.present? %>
          <%= link_to brand_path(id: @product.brand.friendly_id) do %><span><%= @product.brand.display_name %></span><% end %>
        <% end %> <%= @product.name %>
        <% if @product.model_no.present? %>
          <small><%= @product.model_no %></small>
        <% end %>
      </h1>
      <% if @product.discontinued? %>
        <span class="Symbol"><%= t('symbols.product.discontinued') %></span>
      <% end %>
      <%= product_series_subline(@product) %>
    </div>

    <div class="Entity-section Entity-content">
      <%= render "shared/entity_image_gallery", images: @images %>

      <div class="Entity-text">
        <% if @product.description.present? %>
          <div class="Entity-section Rte">
            <%= @product.formatted_description %>
          </div>
        <% end %>

        <%= render "products/data", product: @product, css_class: "Entity-section Data", price_footnote: true %>

        <%= render "shared/product_custom_attributes", attributes: @product.custom_attributes, custom_attributes: @custom_attributes if @product.custom_attributes&.any? %>

        <% if @product.product_options.any? %>
          <div class="Entity-section Product-section">
            <h2><%= Product.human_attribute_name(:product_options) %></h2>
            <ul>
              <% @product.product_options.order(:option).each do |option| %>
                <li>
                  <%= option[:option] %>
                  <% if option[:model_no].present? %>
                    <br><small><%= option[:model_no] %></small>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </div>

    <%= render "shared/product_variants", product: @product, current: @product %>
    <%= render "shared/series_products", series_products: @series_products %>
    <%= render "shared/similar_products", similar: @similar_products, path: product_similar_path(product_id: @product.friendly_id) %>
    <%= render "shared/related_products", groups: @related_products %>

    <ol class="Footnotes">
      <li>The provided price is the retail price given by the manufacturer. If the product has multiple versions, this is the lowest price, i.e. the price for the basic / stock version. Please note that this information might be outdated and that it most likely is different from country to country.</li>
    </ol>
  </div>
  <div class="Entity-sub Product-sub">
    <%= render "products/actions", possessions: @possessions, product: @product, product_variant: @product_variant, bookmark: @bookmark, setups: @setups %>

    <hr>

    <dl>
      <dt>Notes</dt>
      <dd>
        <% if @note.present? %>
          Last updated: <%= link_to product_new_notes_path(product_id: @product.friendly_id) do %>
            <time datetime="<%= format_iso_datetime @note.updated_at %>"><%= format_datetime(@note.updated_at) %></time>
          <% end %>
        <% else %>
          <%= link_to "Add notes", user_signed_in? ? product_new_notes_path(product_id: @product.friendly_id) : new_user_session_path(redirect: product_new_notes_path(product_id: @product.friendly_id)), rel: "nofollow" %>
        <% end %>
      </dd>
      <dt><%= t('product.meta.owned_by') %></dt>
      <dd><%= t('amount_users', count: @product.users.size) %></dd>
    </dl>

    <%= render "shared/entity_meta",
      record: @product,
      edit_path: edit_product_path(id: @product.friendly_id),
      changelog_path: product_changelog_path(product_id: @product.friendly_id),
      contributors: @contributors %>
  </div>
</div>

<%= json_ld_script_tag(product_show_breadcrumb_json_ld(
      product: @product,
      canonical_url: product_url(id: @product.friendly_id)
    )) %>
<%= json_ld_script_tag(product_show_json_ld(
      product: @product,
      meta_desc: @product.meta_desc,
      image_urls: product_show_schema_image_urls(@images)
    )) %>
