<%#
  The fields of a number attribute. `custom_attribute` offers the units of one group of sub
  categories (CustomAttribute#with_units), so the form can render these fields once for each
  group. `id_label` makes the ids unique when it does; the names stay the same, and
  entity_form.js disables the fields of the groups that are hidden. See docs/custom-attributes.md,
  "Units per sub category".

  A group with other units than the definition always posts its unit, also when it offers one
  unit only. Without the unit, the entry would read in the first unit of the definition.
%>
<% label = custom_attribute.label %>
<% entry = custom_attribute.entry_in_own_units(product.custom_attributes&.dig(label)) %>
<% entry = nil unless entry.is_a?(Hash) %>
<% post_single_unit = custom_attribute.units.size == 1 && custom_attribute.units != custom_attribute.base_units %>
<% if custom_attribute.unit_pair? %>
  <% if custom_attribute.inputs.any? %>
    <div class="EntityFormAttribute-label">
      <%= t("custom_attribute_labels.#{label}") %>
    </div>
  <% else %>
    <label for="<%= "product[custom_attributes][#{id_label}]" %>" class="EntityFormAttribute-label">
      <%= t("custom_attribute_labels.#{label}") %>
    </label>
  <% end %>
  <div class="EntityFormAttribute-inputs">
    <%= render "products/custom_attribute_unit_pair", custom_attribute:, entry:, id_label: %>
    <% if custom_attribute.qualified? %>
      <div class="EntityFormAttribute-grid">
        <%= render "products/custom_attribute_qualifier", custom_attribute:, entry:, id_label: %>
      </div>
    <% end %>
  </div>
<% elsif custom_attribute.inputs.any? %>
  <div class="EntityFormAttribute-label">
    <%= t("custom_attribute_labels.#{label}") %>
  </div>
  <div class="EntityFormAttribute-inputs">
    <% if post_single_unit %>
      <input type="hidden" name="<%= "product[custom_attributes][#{label}][unit]" %>" value="<%= custom_attribute.units.first %>">
    <% end %>
    <div class="EntityFormAttribute-grid">
      <% custom_attribute.inputs.each do |input| %>
        <div>
          <label for="<%= "product[custom_attributes][#{id_label}]-value-#{input}" %>" class="Form-label">
            <%= t("custom_attribute_inputs.#{input}") %>
          </label>
          <div class="u-flex u-gap-sm u-alignCenter">
            <input class="Form-input" type="text" inputmode="number" name="<%= "product[custom_attributes][#{label}][value][#{input}]" %>" id="<%= "product[custom_attributes][#{id_label}]-value-#{input}" %>" value="<%= entry&.dig('value').is_a?(Hash) ? entry['value'][input] : "" %>">
            <% if custom_attribute.units.size == 1 %>
              <span class="Unit">
                <%= t("custom_attribute_units.#{custom_attribute.units.first}").html_safe %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <% if custom_attribute.units.size > 1 %>
      <div class="EntityFormAttributes-units u-flex u-gap-md u-alignCenter">
        <% custom_attribute.units.each do |unit| %>
          <div class="u-flex u-gap-sm u-alignCenter">
            <input type="radio" name="<%= "product[custom_attributes][#{label}][unit]" %>" id="<%= "product[custom_attributes][#{id_label}]-#{unit}" %>" value="<%= unit %>"<%= " checked" if entry && unit == entry['unit'] %>>
            <label for="<%= "product[custom_attributes][#{id_label}]-#{unit}" %>">
              <%= t("custom_attribute_units.#{unit}").html_safe %>
            </label>
          </div>
        <% end %>
      </div>
    <% end %>
    <% if custom_attribute.qualified? %>
      <div class="EntityFormAttribute-grid">
        <%= render "products/custom_attribute_qualifier", custom_attribute:, entry:, id_label: %>
      </div>
    <% end %>
  </div>
<% else %>
  <label for="<%= "product[custom_attributes][#{id_label}]" %>" class="EntityFormAttribute-label">
    <%= t("custom_attribute_labels.#{label}") %>
  </label>
  <div class="EntityFormAttribute-inputs">
    <% if post_single_unit %>
      <input type="hidden" name="<%= "product[custom_attributes][#{label}][unit]" %>" value="<%= custom_attribute.units.first %>">
    <% end %>
    <div class="EntityFormAttribute-grid">
      <div class="u-flex u-gap-sm u-alignCenter">
        <input class="Form-input" type="text" inputmode="number" name="<%= "product[custom_attributes][#{label}][value]" %>" id="<%= "product[custom_attributes][#{id_label}]" %>" value="<%= entry ? entry['value'] : '' %>">
        <% if custom_attribute.units.size == 1 %>
          <span class="Unit">
            <%= t("custom_attribute_units.#{custom_attribute.units.first}").html_safe %>
          </span>
        <% end %>
      </div>
    </div>
    <% if custom_attribute.units.size > 1 %>
      <div class="u-flex u-gap-md u-alignCenter">
        <% custom_attribute.units.each do |unit| %>
          <div class="u-flex u-gap-sm u-alignCenter">
            <input type="radio" name="<%= "product[custom_attributes][#{label}][unit]" %>" id="<%= "product[custom_attributes][#{id_label}]-#{unit}" %>" value="<%= unit %>"<%= " checked" if entry && unit == entry['unit'] %>>
            <label for="<%= "product[custom_attributes][#{id_label}]-#{unit}" %>">
              <%= t("custom_attribute_units.#{unit}").html_safe %>
            </label>
          </div>
        <% end %>
      </div>
    <% end %>
    <% if custom_attribute.qualified? %>
      <div class="EntityFormAttribute-grid">
        <%= render "products/custom_attribute_qualifier", custom_attribute:, entry:, id_label: %>
      </div>
    <% end %>
  </div>
<% end %>
