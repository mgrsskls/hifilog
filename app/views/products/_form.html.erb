<% content_for :guidelines do %>
  <%= render "contribute/guidelines/summary_product", edit: include_comment %>
<% end %>

<%= render "shared/product_form", f: f, entity: product, include_comment: include_comment, prefix: "product", brand: brand do %>
  <div class="Form-field">
    <h2><%= f.label :brand %></h2>
    <input type="text" id="brand-filter" autocomplete="off" value="<%= brand.name %>" data-brand-abbreviation="<%= brand.abbreviation %>"<%= " disabled" if brand.id.present? %> placeholder="Search for brand name…" aria-label="Brand name">
  </div>
  <% unless brand && brand.id %>
    <% unless brand && brand.errors.any? %>
      <div class="Form-field Options Options--brands"></div>
      <template id="brand-template">
        <div class="Options-item" data-brand="" hidden>
          <input type="radio" name="product[brand_id]" value="">
          <label></label>
        </div>
      </template>
    <% end %>
    <div class="Form-field ProductFormAddBrand" <%= "hidden" unless brand && brand.errors.any? %>>
      <% unless brand && brand.errors.any? %>
        <p><b>We could not find the brand you are looking for.</b><br>Please feel free to contribute it by adding it here:</p>
      <% end %>
      <fieldset class="ProductFormAddBrand-fieldset">
        <legend>Add new brand</legend>
        <%= f.fields_for :brand do |brand_form| %>
          <%= render "shared/flash_messages", messages: brand.errors.map { |error| ["alert", error.full_message] } if brand && brand.errors.any? %>
          <%= render "brands/name_fields", f: brand_form %>

          <div class="Form-field">
            <%= brand_form.label :website, class: "Form-label" do %>
              <%= Brand.human_attribute_name(:website) %> <small><i>(optional)</i></small>
            <% end %>
            <%= brand_form.url_field :website %>
          </div>

          <div class="Form-field">
            <%= brand_form.label :founded_year, class: "Form-label" do %>
              <%= Brand.human_attribute_name(:founded_year) %> <small><i>(optional)</i></small>
            <% end %>
            <%= brand_form.text_field :founded_year, inputmode: "number", list: "brand-years" %>
            <datalist id="brand-years">
              <% (1900..Date.today.year).to_a.reverse.each do |year| %>
                <option value="<%= year %>"></option>
              <% end %>
            </datalist>
          </div>

          <div class="Form-field">
            <%= brand_form.label :country_code, class: "Form-label" do %>
              <%= Brand.human_attribute_name(:country_code) %> <small><i>(optional)</i></small>
            <% end %>
            <%= brand_form.country_select :country_code, include_blank: true %>
          </div>

          <div class="Form-field">
            <%= brand_form.label :description, class: "Form-label" do %>
              <%= Brand.human_attribute_name(:description) %> <small><i>(optional)</i></small>
            <% end %>
            <%= brand_form.text_area :description %>
          </div>

          <div class="Form-field">
            <span class="Form-label"><%= t('symbols.product.discontinued') %></span>
            <div class="Form-options">
              <%= brand_form.radio_button :discontinued, 0, checked: brand.nil? || (brand.discontinued.nil? || brand.discontinued) == false %>
              <%= brand_form.label :discontinued, "No", value: 0 %>
              <%= brand_form.radio_button :discontinued, 1, checked: !brand.nil? && brand.discontinued == true %>
              <%= brand_form.label :discontinued, "Yes", value: 1  %>
            </div>
          </div>
        <% end %>
      </fieldset>
    </div>
  <% end %>

  <%# Product series (docs/product-series.md). One field for both: select a series of the brand from
      the list, or type a new name to create one. entity_form.js loads the list when the brand
      changes. %>
  <div class="Form-field" data-product-series-field data-series-url="<%= brand_series_index_path(brand_id: '__BRAND__', format: :json) %>">
    <%= f.label :product_series_name, class: "Form-label" do %>
      <%= ProductSeries.model_name.human %> <small><i>(<%= t('optional') %>)</i></small>
    <% end %>
    <%= f.text_field :product_series_name, list: "product-series-options", autocomplete: "off",
                     placeholder: "e.g. Heritage", data: { product_series_input: true } %>
    <datalist id="product-series-options">
      <% if brand&.persisted? %>
        <% brand.product_series.order(:name).each do |series| %>
          <option value="<%= series.name %>"></option>
        <% end %>
      <% end %>
    </datalist>
    <small><%= t('product_series.form.hint') %> <%= guideline_more_link(:product_series) %></small>
  </div>

  <h2>Product</h2>

  <div class="Form-grid u-gap-lg">
    <div>
      <div class="Form-field">
        <div class="Form-label h3">
          <%= f.label :name %>
          <%= guideline_link(:product_name, Product.human_attribute_name(:name)) %>
        </div>
        <%= f.text_field :name, required: true, placeholder: "e.g. #{['Heresy IV', 'HE-1', 'Ongaku'].sample}", data: { product_name_input: true } %>
        <%# Demonstrates the "product name only, no brand name" convention instead of just
            stating it in a collapsed <details> nobody opens. Also doubles as the warning
            when the brand name has been typed in here twice. %>
        <small class="ProductForm-titlePreview" data-product-title-preview hidden></small>
      </div>
    </div>

    <div>
      <div class="Form-field">
        <%= f.label :model_no, class: "Form-label h3" do %>
          Model no. / Alternative name
          <small><i>(optional)</i></small>
        <% end %>
        <%= f.text_field :model_no %>
      </div>
    </div>
  </div>

  <div class="Form-field">
    <h3 class="Form-label"><%= Category.model_name.human.pluralize %></h3>
    <div class="Options is-light EntityForm-subCategories">
      <% menu_categories.each do |columns| %>
        <div>
          <% columns[1].each do |category| %>
            <h4><%= category.name %></h4>
            <ul class="u-flex u-flexColumn u-gap-sm">
              <% category.sub_categories.each do |sub_category| %>
                <li class="Options-item">
                  <%= check_box_tag "product[sub_category_ids][#{sub_category.id}]", sub_category.id, product.sub_category_ids.include?(sub_category.id), name: "product[sub_category_ids][]" %>
                  <%= label_tag "product[sub_category_ids][#{sub_category.id}]", sub_category.name %>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="Form-field EntityForm-attributes">
    <h3>
      <%= SubCategory.human_attribute_name(:custom_attribute_ids) %>
      <%= guideline_link(:specifications, SubCategory.human_attribute_name(:custom_attribute_ids)) %>
    </h3>
    <%#
      The factors of the unit pairs, for the warning in the unit pair rows (entity_form.js,
      setupUnitPairWarning). See CustomAttribute::UNIT_EQUIVALENTS.
    %>
    <div class="Options EntityFormAttributes is-light" data-unit-equivalents="<%= CustomAttribute::UNIT_EQUIVALENTS.to_json %>">
      <%#
        One group for each display group, in display order. CSS hides a group when all its
        attributes are hidden for the selected sub categories. See docs/custom-attributes.md,
        "Display order".
      %>
      <% CustomAttribute.group_for_display(CustomAttribute.all_cached).each do |group, group_definitions| %>
        <div class="EntityFormAttributes-group" role="group" aria-labelledby="custom-attribute-group-<%= group %>">
          <h4 class="EntityFormAttributes-groupHeading" id="custom-attribute-group-<%= group %>"><%= t("custom_attribute_groups.#{group}") %></h4>
          <% group_definitions.each do |custom_attribute| %>
            <%#
              A number attribute whose sub categories offer different units renders its fields
              once for each group of units (CustomAttribute#unit_variants). entity_form.js shows
              the group of the first ticked sub category. See docs/custom-attributes.md, "Units
              per sub category".
            %>
            <% variants = custom_attribute.number_input_type? ? custom_attribute.unit_variants : [] %>
            <% if variants.size > 1 %>
              <%#
                The block that offers the stored unit. entity_form.js keeps it enabled when no ticked
                sub category applies, so the figure is submitted unchanged, like the hidden fields of
                every other attribute.
              %>
              <% stored_unit = custom_attribute.stored_unit(product.custom_attributes&.dig(custom_attribute.label)) %>
              <% keeper = variants.index { |variant_units, _| variant_units.include?(stored_unit) } || 0 %>
              <% variants.each_with_index do |(variant_units, variant_ids), index| %>
                <div class="EntityForm-attribute" data-sub-category-ids="<%= variant_ids %>" data-unit-variant="<%= custom_attribute.label %>"<%= " data-unit-variant-keeps-value" if index == keeper %> hidden>
                  <%= render "products/custom_attribute_number", custom_attribute: custom_attribute.with_units(variant_units), product:,
                                                                 id_label: index.zero? ? custom_attribute.label : "#{custom_attribute.label}-#{variant_units.join('-')}" %>
                </div>
              <% end %>
              <% next %>
            <% end %>
            <%#
              cached_sub_category_ids, not sub_category_ids: this renders every attribute on every
              form load, and the association would be one query each.
            %>
            <div class="EntityForm-attribute" data-sub-category-ids="<%= custom_attribute.cached_sub_category_ids %>" hidden>
              <% if custom_attribute.options&.any? %>
                <% option_scoped = custom_attribute.option_scoped? %>
                <div class="EntityFormAttribute-label">
                  <%= t("custom_attribute_labels.#{custom_attribute.label}") %>
                </div>
                <div class="EntityFormAttribute-options">
                  <% custom_attribute.options.each do |option| %>
                    <%#
                      Which subcategories offer this particular option, so entity_form.js can hide
                      the ones the ticked categories do not offer -- a phono stage should not be
                      asked about I2S. Emitted only when some subcategory actually narrows the list,
                      since otherwise every option applies everywhere and there is nothing to filter.
                    %>
                    <div class="u-flex u-gap-sm u-alignCenter" <%= tag.attributes("data-option-sub-category-ids": custom_attribute.sub_category_ids_for_option(option[0]).to_json) if option_scoped %>>
                      <% if custom_attribute.input_type == 'options' %>
                        <input type="checkbox" name="<%= "product[custom_attributes][#{custom_attribute.label}][]" %>" value="<%= option[0] %>" id="<%= "product[custom_attributes][#{custom_attribute.id}]-#{option[0]}" %>"<%= " checked" if product.custom_attributes.present? && product.custom_attributes[custom_attribute.label]&.include?(option[0]) %>>
                      <% else %>
                        <input type="radio" name="<%= "product[custom_attributes][#{custom_attribute.label}]" %>" value="<%= option[0] %>" id="<%= "product[custom_attributes][#{custom_attribute.id}]-#{option[0]}" %>"<%= " checked" if product.custom_attributes.present? && product.custom_attributes[custom_attribute.label] == option[0] %>>
                      <% end %>
                      <label for="<%= "product[custom_attributes][#{custom_attribute.id}]-#{option[0]}" %>"><%= t("custom_attributes.#{option[1]}") %></label>
                    </div>
                  <% end %>
                </div>
              <% elsif custom_attribute.input_type == 'boolean' %>
              <div class="EntityFormAttribute-label">
                <%= t("custom_attribute_labels.#{custom_attribute.label}") %>
              </div>
              <div class="EntityFormAttribute-options">
                <div class="u-flex u-gap-sm u-alignCenter">
                  <input type="radio" name="<%= "product[custom_attributes][#{custom_attribute.label}]" %>" value="1" id="<%= "product[custom_attributes][#{custom_attribute.id}]-1" %>"<%= " checked" if product.custom_attributes.present? && product.custom_attributes[custom_attribute.label] == true %>>
                  <label for="<%= "product[custom_attributes][#{custom_attribute.id}]-1" %>">Yes</label>
                </div>
                <div class="u-flex u-gap-sm u-alignCenter">
                  <input type="radio" name="<%= "product[custom_attributes][#{custom_attribute.label}]" %>" value="0" id="<%= "product[custom_attributes][#{custom_attribute.id}]-0" %>"<%= " checked" if product.custom_attributes.present? && product.custom_attributes[custom_attribute.label] == false %>>
                  <label for="<%= "product[custom_attributes][#{custom_attribute.id}]-0" %>">No</label>
                </div>
              </div>
              <% else %>
                <%= render "products/custom_attribute_number", custom_attribute: custom_attribute.with_units(variants.first&.first || custom_attribute.units), product:, id_label: custom_attribute.label %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

<% end %>
