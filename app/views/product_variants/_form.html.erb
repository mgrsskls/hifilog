<% content_for :guidelines do %>
  <%= render "contribute/guidelines/summary_product_variant", edit: include_comment %>
<% end %>

<%= render "shared/product_form", f: f, entity: product_variant, include_comment: include_comment, prefix: "product_variant", brand: brand do %>
  <%# A variant has no series of its own; it uses the series of its product (docs/product-series.md). %>
  <% if product_variant.product&.product_series %>
    <div class="Form-field">
      <span class="Form-label"><%= ProductSeries.model_name.human %></span>
      <p><%= product_variant.product.product_series.name %> <small><i>(<%= t('product_series.form.from_product') %>)</i></small></p>
    </div>
  <% end %>
  <div class="Form-grid u-gap-lg">
    <div>
      <div class="Form-field">
        <%= f.label :name, class: "Form-label h3" %>
        <%= f.text_field :name, required: true %>
      </div>
    </div>

    <div>
      <div class="Form-field">
        <%= f.label :model_no, class: "Form-label h3" do %>
          Model no. / Alternative name
          <small><i>(optional)</i></small>
        <% end %>
        <%= f.text_field :model_no %>
      </div>
    </div>
  </div>
<% end %>
