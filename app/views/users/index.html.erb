<div class="Heading">
  <h1>Users</h1>
</div>

<% content_for :css do %>
  <%= stylesheet_link_tag "users" %>
<% end %>
<ol class="Users">
  <% @users_by_products.each_with_index do |user, i| %>
    <li class="Users-user">
      <div class="EntityListItem">
        <div class="EntityList-name">
          <div class="u-flex u-gap-md u-alignCenter">
            <% if user["profile_visibility"] == "hidden" %>
              <div class="u-flex u-gap-md u-alignCenter u-flexGrow">
                <%= render "shared/avatar", user: user, size: 64 %>
                <b><%= user["user_name"] %></b>
              </div>
            <% else %>
              <%= link_to user.profile_path, class: "u-flex u-gap-md u-alignCenter u-flexGrow" do %>
                <%= render "shared/avatar", user: user, size: 64 %>
                <b><%= user["user_name"] %></b>
              <% end %>
            <% end %>
            <% if user_signed_in? && current_user.id != user.id && !user.hidden? && !@blocked_user_ids.include?(user.id) %>
              <div class="Users-follow">
                <%= render "shared/follow_button",
                            user:,
                            user_follow: @follows_by_user_id[user.id],
                            redirect_to: users_path %>
              </div>
            <% end %>
          </div>
        </div>
        <dl class="EntityListItem-data Data u-pbs-1">
          <dt>Contributions:</dt>
          <dd><%= user["count"] %></dd>

          <dt>Member since:</dt>
          <dd>
            <time datetime="<%= user["created_at"] %>"><%= format_date(user["created_at"]).html_safe %></time>
          </dd>
        </dl>
      </div>
    </li>
  <% end %>
</ol>
