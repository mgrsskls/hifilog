<div class="Form Form--centered">
  <div class="Heading">
    <h1><%= t('user_form.signup') %></h1>
    <div class="Rte">
      <p>Maintain your collection & automatically contribute to building the largest database for hi-fi products and brands.</p>
      <p><strong>No tracking, no costs.</strong></p>
    </div>
  </div>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "shared/flash_messages", messages: resource.errors.full_messages.map { |message| [ :alert, message ] } if resource.errors.full_messages.any? %>

    <div class="Form-field">
      <%= f.label :user_name, class: 'Form-label' do %>
        <%= t('user.edit.update.fields.user_name') %>
      <% end %>
      <%= f.text_field :user_name, required: true %>
    </div>

    <div class="Form-field">
      <%= f.label :email, class: 'Form-label' do %>
        Email
      <% end %>
      <%= f.email_field :email, required: true, autocomplete: "email" %>
      <small>Your e-mail address is not public and will never be visible to other users.</small>
    </div>

    <div class="Form-field">
      <%= f.label :password, class: 'Form-label' do %>
        Password
      <% end %>
      <%= f.password_field :password, required: true, autocomplete: "new-password" %>
      <% if @minimum_password_length %>
        <small class="Form-hint"><%= @minimum_password_length %> characters minimum</small>
      <% end %>
    </div>

    <div class="Form-field">
      <%= f.label :password_confirmation, class: 'Form-label' do %>
        Password confirmation
      <% end %>
      <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
    </div>

    <fieldset class="Form-field">
      <legend class="Form-label"><%= t('user_form.profile_visibility.heading') %></legend>
      <div>
        <%= f.radio_button :profile_visibility, :visible %>
        <%= f.label :profile_visibility_visible, t('user.edit.update.profile_visibility.visible') %>
      </div>
      <div>
        <%= f.radio_button :profile_visibility, :logged_in_only %>
        <%= f.label :profile_visibility_logged_in_only, t('user.edit.update.profile_visibility.logged_in_only') %>
      </div>
      <div>
        <%= f.radio_button :profile_visibility, :hidden %>
        <%= f.label :profile_visibility_hidden, t('user.edit.update.profile_visibility.hidden') %>
      </div>
    </fieldset>

    <fieldset class="Form-field">
      <legend class="Form-label"><%= t('user_form.privacy_policy') %></legend>
      <div>
        <input type="checkbox" name="privacy_policy_accepted" id="privacy-policy-accepted" value="1" required>
        <label for="privacy-policy-accepted">
          <%= t('user_form.privacy_policy_accept') %>
          <%= link_to t('user_form.privacy_policy'), privacy_policy_path %>
        </label>
      </div>
    </fieldset>

    <div class="Form-submit">
      <%= cloudflare_turnstile_tag %>
      <button type="submit" class="Button"><%= t('user_form.signup') %></button>
    </div>
  <% end %>

  <%= render "users/shared/links" %>
</div>
