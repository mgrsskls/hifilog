<% content_for :css do %>
  <%= stylesheet_link_tag "numbers" %>
<% end %>
<%= render layout: "users/shared/layout", locals: { user: @user, heading: @heading, categories: @categories, sub_category: @sub_category, render_headline: true } do %>
  <div class="DashboardStatsWrapper">
    <div class="DashboardStats">
      <% [
        { model: Product, created: @products_created, edited: @products_edited },
        { model: Brand, created: @brands_created, edited: @brands_edited }
      ].each do |entry| %>
        <div class="DashboardNumbersWrapper">
          <h3><%= entry[:model].model_name.human.pluralize %></h3>
          <ul class="DashboardNumbers">
            <li>
              <div class="DashboardNumber u-statCard">
                <span class="DashboardNumber-heading"><%= t('headings.created') %></span>
                <span class="DashboardNumber-value"><%= entry[:created] %></span>
              </div>
            </li>
            <li>
              <div class="DashboardNumber u-statCard">
                <span class="DashboardNumber-heading"><%= t('headings.edited') %></span>
                <span class="DashboardNumber-value"><%= entry[:edited] %></span>
              </div>
            </li>
          </ul>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
