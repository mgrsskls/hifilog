<%
  view_all_path ||= nil
  view_all_label ||= (t('overview.view_all') if view_all_path)
  heading_class ||= nil
  section_class ||= nil
%>
<div class="Entity-section <%= section_class %>">
  <%= render "shared/overview/section_heading", heading:, heading_class:, view_all_path:, view_all_label: %>

  <%= yield %>

  <% if view_all_path %>
    <div class="MoreLink MoreLink--sm">
      <%= link_to view_all_path do %>
        <span><%= view_all_label %></span> &rarr;
      <% end %>
    </div>
  <% end %>
</div>
