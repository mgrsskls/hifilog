<%#
  A second reading is shown only when the definition offers two units *and* the two are a
  convertible pair (CustomAttribute::UNIT_EQUIVALENTS). The pair test is a guard, not a special
  case for one attribute: no definition offers two unconvertible units any more, because a
  measurement condition belongs in a qualifier. loudspeaker_sensitivity was the one that did.

  A qualifier, where the entry has one, follows the reading in parentheses. There is one for
  the whole entry, so a multi-input value carries it once, after the last input.
%>
<% css_class ||= "Data" %>
<div class="Entity-section">
  <h2>Characteristics</h2>
  <dl class="<%= css_class %>">
    <% Array(attributes).sort.each do |ca| %>
      <% active_record = custom_attributes[ca[0]] %>
      <% if active_record.present? %>
        <dt><%= t("custom_attribute_labels.#{ca[0]}") %></dt>
        <dd>
          <% if ca[1].is_a?(Hash) %>
            <% unit = ca[1]['unit'].present? ? ca[1]['unit'] : active_record.units.first %>
            <% translated_unit = t("custom_attribute_units.#{unit}").html_safe if unit.present? %>
            <% equivalent = CustomAttribute.equivalent_unit(unit) if active_record.units.size == 2 %>
            <% qualifier = CustomAttribute.qualifier_label(ca[1]) %>
            <% if ca[1]['value'].is_a?(Hash) %>
              <% ca[1]['value'].each do |v| %>
                <%= t("custom_attribute_inputs.#{v[0]}") %>: <%= number_with_precision(v[1], precision: 4, strip_insignificant_zeros: true) %> <%= translated_unit %>
                <% if equivalent %>
                  / <%= number_with_precision(v[1] * equivalent[1], precision: 4, strip_insignificant_zeros: true) %> <%= t("custom_attribute_units.#{equivalent[0]}").html_safe %>
                <% end %>
                <br>
              <% end %>
              <%= "(#{qualifier})" if qualifier.present? %>
            <% elsif ca[1]['value'].present? %>
              <%= number_with_precision(ca[1]['value'], precision: 4, strip_insignificant_zeros: true) %> <%= translated_unit %>
              <% if equivalent %>
                / <%= number_with_precision(ca[1]['value'] * equivalent[1], precision: 4, strip_insignificant_zeros: true) %> <%= t("custom_attribute_units.#{equivalent[0]}").html_safe %>
              <% end %>
              <%= "(#{qualifier})" if qualifier.present? %>
            <% else %>
              n/a
            <% end %>
          <% elsif ca[1].is_a?(Array) %>
            <%= ca[1].map { |id| t("custom_attributes.#{active_record.options[id.to_s]}") }.join(", ") %>
          <% else %>
            <% if active_record[:input_type] == 'boolean' %>
              <%= t("custom_attributes.#{ca[1] ? 'yes' : 'no'}") %>
            <% else %>
              <%= t("custom_attributes.#{active_record.options[ca[1].to_s]}") %>
            <% end %>
          <% end %>
        </dd>
      <% end %>
    <% end %>
  </dl>
</div>
