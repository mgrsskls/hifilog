<%#
  A number entry reads as CustomAttributeReading describes it: the stated figures, and the
  conversion of a figure whose counterpart is not stated. See docs/custom-attributes.md,
  "Two units".

  A qualifier, where the entry has one, follows the reading in parentheses. There is one for
  the whole entry, so a multi-input value carries it once, after the last input.
%>
<%#
  The rows follow the display order of the definitions (CustomAttribute.group_for_display), not
  the key order of the product's jsonb. Each group gets a heading and its own list. A group
  without a value on this product is not shown. See docs/custom-attributes.md, "Display order".
%>
<% css_class ||= "Data" %>
<% values = attributes.to_h %>
<% definitions = (custom_attributes || {}).values_at(*values.keys).compact %>
<div class="Entity-section Specifications">
  <h2>Specifications</h2>
  <% CustomAttribute.group_for_display(definitions).each do |group, group_definitions| %>
    <h3><%= t("custom_attribute_groups.#{group}") %></h3>
    <dl class="<%= css_class %>">
      <% group_definitions.each do |active_record| %>
        <% ca = [active_record.label, values[active_record.label]] %>
        <dt><%= t("custom_attribute_labels.#{ca[0]}") %></dt>
        <dd>
          <% if ca[1].is_a?(Hash) %>
            <% lines = custom_attribute_reading_lines(active_record, ca[1]) %>
            <% qualifier = CustomAttribute.qualifier_label(ca[1]) %>
            <% if lines.any? %>
              <%= safe_join(lines, tag.br) %>
              <%= "(#{qualifier})" if qualifier.present? %>
            <% else %>
              n/a
            <% end %>
          <% elsif ca[1].is_a?(Array) %>
            <%= ca[1].map { |id| t("custom_attributes.#{active_record.options[id.to_s]}") }.join(", ") %>
          <% else %>
            <% if active_record[:input_type] == 'boolean' %>
              <%= t("custom_attributes.#{ca[1] ? 'yes' : 'no'}") %>
            <% else %>
              <%= t("custom_attributes.#{active_record.options[ca[1].to_s]}") %>
            <% end %>
          <% end %>
        </dd>
      <% end %>
    </dl>
  <% end %>
</div>
