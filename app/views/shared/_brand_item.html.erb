<% render_completeness ||= false %>

<% main = capture do %>
  <%= link_to brand.display_name, brand_path(id: brand.friendly_id), class: "EntityListItem-name" %>
  <% if brand.abbreviation.present? %>
    <span class="EntityListItem-modelName">
      <%= brand.name %>
    </span>
  <% end %>
<% end %>

<% content = capture do %>
  <% if brand.categories.any? %>
    <ul class="EntityListItem-tags">
      <% brand.categories.each do |category| %>
      <li class="Tag"><%= category.name %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="u-flex u-spaceBetween u-gap-sm u-gapX-md u-flexWrap u-mt-auto">
    <% if brand.country_name.present? %>
      <div class="EntityList-country u-flex u-gap-smd u-alignCenter">
        <%= render "shared/flag", country_code: brand.country_code, country_name: brand.country_name, wrap_in_span: true %>
      </div>
    <% end %>

    <div class="EntityList-productsCount">
      <%= link_to "#{count} #{t('activerecord.models.product', count: count)}", path_to_brand %>
    </div>
  </div>
<% end %>

<% actions = capture do %>
  <%= yield %>
<% end %>

<%= render "shared/entity_list_item",
  item: brand,
  item_type: 'Brand',
  is_discontinued: brand.discontinued,
  main:,
  content:,
  actions:,
  name: brand.display_name,
  list_image: (brand.logo.attached? ? brand.logo : nil),
  list_image_width: 640,
  list_image_height: 427,
  render_completeness:,
  completeness: brand.completeness
%>
