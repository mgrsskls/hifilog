<%#
  Unit conversion lives on CustomAttribute (UNIT_EQUIVALENTS), not here: this partial and the
  product show page each used to carry their own copy, and the two had drifted to different
  pound factors from each other and from the filter.
%>
<% content_for :css do %>
  <%= stylesheet_link_tag "changelog" %>
<% end %>

<h1><%= t('headings.changelog') %> <span><%= model.name %></span></h1>
<% if versions.any? %>
<ol reversed class="Changelog">
    <% versions.reverse.each_with_index do |version, i| %>
      <%
        # One lookup per version instead of two: the previous form called User.find_by to test
        # for existence and then User.find to fetch the same row again.
        user = version.whodunnit.present? ? User.find_by(id: version.whodunnit) : nil
        user_fallback = version.whodunnit.present? ? "<i>Deleted</i>" : "hifilog.com"
      %>
      <%# A series changelog also lists the products that were added or removed. See docs/product-series.md, "Changelog and contributors". %>
      <% if model.is_a?(ProductSeries) && version.product_series_ids.present? %>
        <%= render "shared/changelog_series_product", version:, series: model, product: (local_assigns.fetch(:products, {})[version.item_id] if version.item_type == "Product"), user:, user_fallback: %>
        <% next %>
      <% end %>
      <li class="Changelog-item">
        <p class="Changelog-itemHeading">
          <b>
          <% if version.event == "create" %>
            <b><%= t('headings.created') %></b>
          <% else %>
            <%= t('changelog.change') %>
          <% end %>
          </b>
          <%= render "shared/changelog_author", version:, user:, user_fallback: %>
        </p>

          <% changelog = changelog_changes(version) %>
          <ul>
            <% changelog.each do |change| %>
              <%# A conversion between product and variant: one line, the original is deleted. See docs/catalog-model.md, "Changelog". %>
              <% if change[0] == "converted_from" %>
                <li><b><%= t('brand.converted_from') %></b> <%= change[1][1] %></li>
                <% next %>
              <% end %>
              <% unless %w[slug products_count].include?(change[0]) %>
                <% before = capture do %>
                            <% if change[0] == "custom_attributes" %>
                              <% if change[1][0].present? %>
                                <ul>
                                  <% JSON.parse(change[1][0]).sort.each do |ca| %>
                                    <% active_record = CustomAttribute.find_by(label: ca[0]) %>
                                    <% if active_record.present? %>
                                      <li>
                                        <b><%= t("custom_attribute_labels.#{ca[0]}") %>:</b><br>
                                        <% if ca[1].is_a?(Hash) %>
                                          <% unit = ca[1]['unit'].present? ? ca[1]['unit'] : active_record.units.first %>
                                          <% translated_unit = safe_unit_entities(t("custom_attribute_units.#{unit}")) if unit.present? %>
                                          <% equivalent = CustomAttribute.equivalent_unit(unit) if active_record.units.size == 2 %>
                                          <% qualifier = CustomAttribute.qualifier_label(ca[1]) %>
                                          <% if ca[1]['value'].is_a?(Hash) %>
                                            <% ca[1]['value'].each do |v| %>
                                              <%= t("custom_attribute_inputs.#{v[0]}") %>: <%= number_with_precision(v[1], precision: 4, strip_insignificant_zeros: true) %> <%= translated_unit %>
                                              <% if equivalent %>
                                                / <%= number_with_precision(v[1] * equivalent[1], precision: 4, strip_insignificant_zeros: true) %> <%= safe_unit_entities(t("custom_attribute_units.#{equivalent[0]}")) %>
                                              <% end %>
                                              <br>
                                            <% end %>
                                            <%= "(#{qualifier})" if qualifier.present? %>
                                          <% elsif ca[1]['value'].present? %>
                                            <%= number_with_precision(ca[1]['value'], precision: 4, strip_insignificant_zeros: true) %> <%= translated_unit %>
                                            <% if equivalent %>
                                                / <%= number_with_precision(ca[1]['value'] * equivalent[1], precision: 4, strip_insignificant_zeros: true) %> <%= safe_unit_entities(t("custom_attribute_units.#{equivalent[0]}")) %>
                                            <% end %>
                                            <%= "(#{qualifier})" if qualifier.present? %>
                                          <% else %>
                                            n/a
                                          <% end %>
                                        <% elsif ca[1].is_a?(Array) %>
                                          <%= ca[1].map { |id| t("custom_attributes.#{active_record.options[id.to_s]}") }.join(", ") %>
                                        <% else %>
                                          <% if active_record[:input_type] == 'boolean' %>
                                            <%= t("custom_attributes.#{ca[1] ? 'yes' : 'no'}") %>
                                          <% else %>
                                            <%= t("custom_attributes.#{active_record.options[ca[1].to_s]}") %>
                                          <% end %>
                                        <% end %>
                                      </li>
                                    <% end %>
                                  <% end unless change[1][0].nil? %>
                                </ul>
                              <% else %>
                                -
                              <% end %>
                            <% elsif change[0] == "brand_id" && change[1][0].present? %>
                              <%= changelog_brand_name(change[1][0]) %>
                            <% elsif change[0] == "product_series_id" && change[1][0].present? %>
                              <%= changelog_series_name(change[1][0]) %>
                            <% elsif change[0] == "sub_category_ids" %>
                              <%= change[1][0].present? ? changelog_sub_category_names(change[1][0]) : "-" %>
                            <% elsif change[0] == "product_options" %>
                              <%= change[1][0].present? ? safe_join(change[1][0], tag.br) : "-" %>
                            <% elsif change[0] == "country_code" && change[1][0].present? %>
                              <%= country_name_from_country_code(change[1][0]) %>
                            <% elsif !change[1][0].nil? %>
                              <% if change[1][0] == false %>
                                No
                              <% elsif change[1][0] == true %>
                                Yes
                              <% else %>
                                <%= change[1][0] %>
                              <% end %>
                            <% else %>
                              -
                            <% end %>
                <% end %>
                <% after = capture do %>
                            <% if change[0] == "custom_attributes" %>
                              <% if change[1][1].present? %>
                                <ul>
                                  <% JSON.parse(change[1][1]).sort.each do |ca| %>
                                    <% active_record = CustomAttribute.find_by(label: ca[0]) %>
                                    <% if active_record.present? %>
                                    <li>
                                        <b><%= t("custom_attribute_labels.#{ca[0]}") %>:</b><br>
                                        <% if ca[1].is_a?(Hash) %>
                                          <% unit = ca[1]['unit'].present? ? ca[1]['unit'] : active_record.units.first %>
                                          <% translated_unit = t("custom_attribute_units.#{unit}").html_safe if unit.present? %>
                                          <% equivalent = CustomAttribute.equivalent_unit(unit) if active_record.units.size == 2 %>
                                          <% qualifier = CustomAttribute.qualifier_label(ca[1]) %>
                                          <% if ca[1]['value'].is_a?(Hash) %>
                                            <% ca[1]['value'].each do |v| %>
                                              <%= t("custom_attribute_inputs.#{v[0]}") %>: <%= number_with_precision(v[1], precision: 4, strip_insignificant_zeros: true) %> <%= translated_unit %>
                                              <% if equivalent %>
                                                / <%= number_with_precision(v[1] * equivalent[1], precision: 4, strip_insignificant_zeros: true) %> <%= safe_unit_entities(t("custom_attribute_units.#{equivalent[0]}")) %>
                                              <% end %>
                                              <br>
                                            <% end %>
                                            <%= "(#{qualifier})" if qualifier.present? %>
                                          <% elsif ca[1]['value'].present? %>
                                            <%= number_with_precision(ca[1]['value'], precision: 4, strip_insignificant_zeros: true) %> <%= translated_unit %>
                                            <% if equivalent %>
                                                / <%= number_with_precision(ca[1]['value'] * equivalent[1], precision: 4, strip_insignificant_zeros: true) %> <%= safe_unit_entities(t("custom_attribute_units.#{equivalent[0]}")) %>
                                            <% end %>
                                            <%= "(#{qualifier})" if qualifier.present? %>
                                          <% else %>
                                            n/a
                                          <% end %>
                                        <% elsif ca[1].is_a?(Array) %>
                                          <%= ca[1].map { |id| t("custom_attributes.#{active_record.options[id.to_s]}") }.join(", ") %>
                                        <% else %>
                                          <% if active_record[:input_type] == 'boolean' %>
                                            <%= t("custom_attributes.#{ca[1] ? 'yes' : 'no'}") %>
                                          <% else %>
                                            <%= t("custom_attributes.#{active_record.options[ca[1].to_s]}") %>
                                          <% end %>
                                        <% end %>
                                      </li>
                                    <% end %>
                                  <% end unless change[1][1].nil? %>
                                </ul>
                              <% else %>
                                -
                              <% end %>
                            <% elsif change[0] == "brand_id" && change[1][1].present? %>
                              <%= changelog_brand_name(change[1][1]) %>
                            <% elsif change[0] == "product_series_id" && change[1][1].present? %>
                              <%= changelog_series_name(change[1][1]) %>
                            <% elsif change[0] == "sub_category_ids" %>
                              <%= change[1][1].present? ? changelog_sub_category_names(change[1][1]) : "-" %>
                            <% elsif change[0] == "product_options" %>
                              <%= change[1][1].present? ? safe_join(change[1][1], tag.br) : "-" %>
                            <% elsif change[0] == "country_code" && change[1][1].present? %>
                              <%= country_name_from_country_code(change[1][1]) %>
                            <% elsif !change[1][1].nil? %>
                              <% if change[1][1] == false %>
                                No
                              <% elsif change[1][1] == true %>
                                Yes
                              <% else %>
                                <%= change[1][1] %>
                              <% end %>
                            <% else %>
                              -
                            <% end %>
                <% end %>
                <% unless before.strip == "-" && after.strip == "-" %>
                  <li>
                      <b><%= t('brand.' + change[0]) %></b>
                      <dl>
                            <dt><%= t('changelog.before') %></dt>
                            <dd class="Changelog-old"><%= before %></dd>

                            <dt><%= t('changelog.after') %></dt>
                            <dd class="Changelog-new"><%= after %></dd>
                      </dl>
                  </li>
                <% end %>
              <% end %>
            <% end %>
          </ul>

        <% if version.comment.present? %>
          <div class="Changelog-itemComment Rte">
            <p><b><%= t('changelog.comment') %>:</b></p>
            <%= sanitize(simple_format(version.comment.strip), tags: %w(p b i strong em br ul ol li)) %>
          </div>
        <% end %>
      </li>
    <% end %>
  </ol>
<% else %>
  <p>No changelog entries so far.</p>
<% end %>

<%= render "shared/back_link", path: back_path %>
