<%
  case type
  when 'Brand' then param_type = 'brand'
  when 'Event' then param_type = 'event'
  else param_type = 'event'
  end
%>
<div class="Symbols"
  <%= "data-product-variant=#{item.id}" if type == 'ProductVariant' %>
  <%= "data-product=#{item.id}" if type == 'Product' %>
  <%= "data-brand=#{item.id}" if type == 'Brand' %>
  <%= "data-event=#{item.id}" if type == 'Event' %>
>
  <div class="Symbols-item" data-symbol="in_collection" hidden title="<%= t("symbols.#{param_type}.in_your_collection") %>">
    <%= render "shared/state_icon", aria_label: t("symbols.#{param_type}.in_your_collection") %>
  </div>

  <div class="Symbols-item" data-symbol="previously_owned" hidden title="<%= t("symbols.#{param_type}.prev_owned") %>">
    <span aria-label="<%= t("symbols.#{param_type}.prev_owned") %>" class="IconSymbol IconSymbol--prevOwned">P</span>
  </div>

  <div class="Symbols-item" data-symbol="following" hidden title="<%= t("symbols.#{param_type}.following") %>">
    <span aria-label="<%= t("symbols.#{param_type}.following") %>" class="IconSymbol IconSymbol--following">F</span>
  </div>

  <div class="Symbols-item" data-symbol="bookmarked" hidden title="<%= t("symbols.in_your_bookmarks") %>">
    <svg aria-label="<%= t("symbols.in_your_bookmarks") %>" class="IconSymbol IconSymbol--bookmark" xmlns="http://www.w3.org/2000/svg" viewBox="2 2 20 20" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.6 3.32c1.1.13 1.9 1.08 1.9 2.19V21L12 17.25 4.5 21V5.5c0-1.1.8-2.05 1.9-2.18a48.5 48.5 0 0 1 11.2 0Z"/></svg>
  </div>
</div>
