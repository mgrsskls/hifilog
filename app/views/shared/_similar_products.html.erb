<%# Similar Products: products that fill the same role as this product. See docs/similar-products.md. %>
<%# path: the full list of the product or the variant. %>
<%# Renders nothing when no candidate has the minimum score. "View all" shows only when the full list has more items. %>
<% if similar.items.present? %>
  <%= render "shared/entity_section",
      heading: t('similar_products.heading'),
      section_class: "Entity-section--similarProducts",
      view_all_path: (path if similar.total_count > similar.items.size) do %>
    <%= render "shared/products_table",
        products: similar.items,
        render_completeness: false
    %>
  <% end %>
<% end %>
