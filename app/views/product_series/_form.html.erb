<%# Name and description of a product series. The brand can not change. See docs/product-series.md.
    extra_fields (optional): more fields inside the form, before the submit button, as captured HTML.
    The edit page uses it for the products of the brand. %>
<% extra_fields ||= nil %>
<% content_for :css do %>
  <%= stylesheet_link_tag "entity_form" %>
<% end %>

<%= render "contribute/guidelines/summary_product_series" %>

<% if series.errors.any? %>
  <%= render "shared/flash_messages", messages: series.errors.map { |error| ["alert", error.full_message] } %>
<% end %>

<%= form_with model: series, url: url, method: method, scope: :product_series, class: "Form EntityForm" do |f| %>
  <div class="Form-field">
    <span class="Form-label"><%= Brand.model_name.human %></span>: <%= brand.display_name %>
  </div>

  <div class="Form-field">
    <%= f.label :name, class: "Form-label" %>
    <%= f.text_field :name, required: true, placeholder: "e.g. Heritage" %>
  </div>

  <div class="Form-field">
    <%= f.label :description, class: "Form-label" do %>
      <%= ProductSeries.human_attribute_name(:description) %> <small><i>(<%= t('optional') %>)</i></small>
    <% end %>
    <%= f.text_area :description, rows: 8 %>
  </div>

  <% if series.persisted? %>
    <div class="Form-field">
      <%= f.label :comment, class: "Form-label" do %>
        <%= t('changelog.comment') %> <small><i>(<%= t('optional') %>)</i></small>
      <% end %>
      <%= f.text_field :comment %>
    </div>
  <% else %>
    <div class="Form-field">
      <div class="u-flex u-gap-sm u-alignCenter">
        <%= check_box_tag :assign_products, "1", params[:assign_products].present? %>
        <%= label_tag :assign_products, t('product_series.new.assign_products') %>
      </div>
    </div>
  <% end %>

  <%= extra_fields %>

  <div class="Form-submit">
    <%= f.submit series.persisted? ? t('product_series.edit.submit') : t('product_series.new.submit'), class: "Button" %>
  </div>
<% end %>
