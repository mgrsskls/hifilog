<div class="Heading">
  <h1><%= t('contribute.index.heading') %></h1>
</div>

<div class="Rte">
  <p><%= t('contribute.index.intro', link: contribute_guidelines_path).html_safe %></p>
</div>

<h2><%= Product.model_name.human(count: 2) %></h2>

<ul class="ContributeQueues">
  <li class="ContributeQueue">
    <h3 class="ContributeQueue-heading">
      <%= link_to t('contribute.index.add_product_heading'), new_product_path %>
    </h3>
    <p><%= t('contribute.index.add_product_body') %></p>
  </li>

  <li class="ContributeQueue">
    <h3 class="ContributeQueue-heading">
      <%= link_to t('contribute.incomplete_products.heading'), contribute_incomplete_products_path %>
    </h3>
    <p><%= t('contribute.index.incomplete_products_body') %></p>
  </li>
</ul>

<h2><%= Brand.model_name.human(count: 2) %></h2>

<ul class="ContributeQueues">
  <li class="ContributeQueue">
    <h3 class="ContributeQueue-heading">
      <%= link_to t('contribute.index.add_brand_heading'), new_brand_path %>
    </h3>
    <p><%= t('contribute.index.add_brand_body') %></p>
  </li>

  <li class="ContributeQueue">
    <h3 class="ContributeQueue-heading">
      <%= link_to t('contribute.brands_without_products.heading'), contribute_brands_without_products_path %>
    </h3>
    <p><%= t('contribute.index.brands_without_products_body') %></p>
  </li>

  <li class="ContributeQueue">
    <h3 class="ContributeQueue-heading">
      <%= link_to t('contribute.incomplete_brands.heading'), contribute_incomplete_brands_path %>
    </h3>
    <p><%= t('contribute.index.incomplete_brands_body') %></p>
  </li>
</ul>
